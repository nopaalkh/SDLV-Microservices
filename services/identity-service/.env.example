# Identity Service Environment Variables

# Service Configuration
PORT=3001
JWT_SECRET=your_jwt_secret_here_32_chars_min
JWT_EXPIRATION=24h

# Database Configuration
DB_HOST=identity-db
DB_PORT=5432
DB_USER=identity_user
DB_PASSWORD=your_db_password_here
DB_NAME=identity_db
DB_SSLMODE=disable

# PostgreSQL initialization variables (used by docker-compose)
POSTGRES_USER=identity_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=identity_db

# Admin Account (change these in production!)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong_admin_password

# Internal API Key (for inter-service communication)
INTERNAL_API_KEY=your_internal_api_key_here

# Application Configuration
ENV=development

# Email Configuration
SMTP_HOST=mailhog
SMTP_PORT=1025
FRONTEND_URL=http://localhost:5173
