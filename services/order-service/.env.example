# Order Service Environment Variables

# Service Configuration
PORT=3003
JWT_SECRET=your_jwt_secret_here_32_chars_min

# Database Configuration
DB_HOST=order-db
DB_PORT=5432
DB_USER=order_user
DB_PASSWORD=your_db_password_here
DB_NAME=order_db
DB_SSLMODE=disable

# PostgreSQL initialization variables (used by docker-compose)
POSTGRES_USER=order_user
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=order_db

# Email Configuration (for SMTP/Mailhog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Midtrans Payment Configuration
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_CLIENT_KEY=your_midtrans_client_key_here
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_API_BASE_URL=https://api.sandbox.midtrans.com

# Application Configuration
ENV=development

# Service URLs
CATALOG_SERVICE_URL=http://catalog-service:3002
IDENTITY_SERVICE_URL=http://identity-service:3001

# Internal API Key (for communicating with Identity Service)
INTERNAL_API_KEY=your_internal_api_key_here
